watch_dir: "/Users/jpg/Dropbox/Camera Uploads"
api_key: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
shared_secret: "XXXXXXXXXXXXXXXX"
archive_dir: "/mnt/archive/PIX"
tagsetprefix: "grouping:set="
visibilityprefix: "sharing:visibility="
tag_replacements:
  LensType:
    "$camera:lens=fisheye": "Rokinon 7.5mm 1:3.5 UMC Fisheye CS"
    "$camera:lens=om": "Olympus OM-SYSTEM ZUIKO MC Auto-S 1:1,8 50mm"
  FocalLength:
    "$camera:lens=fisheye": "7.5 mm"
    "$camera:lens=om": "50 mm"
  FocalLengthIn35mmFormat:
    "$camera:lens=fisheye": "7.5 mm"
    "$camera:lens=om": "50 mm"
blocked_tags:
  LensType: "NO-LENS"
associated_files:
    - /JPG$/NEF/i
convert_files:
    m2ts: "avconv -i '%{file}' -vcodec libx264 -acodec aac -strict experimental '%{file}.mp4'"
    mts: "avconv -i '%{file}' -vcodec libx264 -acodec aac -strict experimental '%{file}.mp4'"